CinnabarIsland_PokemonLab_ResearchRoom_Text_EeveeCanEvolveIntroThreeMons::
    .string "EEVEE can evolve into one of three\n"
    .string "kinds of POKéMON.$"

CinnabarIsland_PokemonLab_ResearchRoom_Text_LegendaryBirdEmail::
    .string "There's an e-mail message.\p"
    .string "… … …\p"
    .string "There are three legendary bird\n"
    .string "POKéMON.\p"
    .string "They are ARTICUNO, ZAPDOS, and\n"
    .string "MOLTRES.\p"
    .string "Their whereabouts are unknown.\p"
    .string "We plan to explore the cavern\n"
    .string "close to CERULEAN.\p"
    .string "From: POKéMON RESEARCH TEAM…$"

CinnabarIsland_PokemonLab_ResearchRoom_Text_AnAmberPipe::
    .string "An amber pipe!$"


CinnabarIsland_PokemonLab_ResearchRoom_Text_TrackedSinceItAppeared::
    .string "Ever since that egg turned up on\n"
    .string "PROFESSOR OAK's doorstep, we've\n"
    .string "been logging every reading we\n"
    .string "could get off it.\p"
    .string "We finally isolated something\n"
    .string "worth handing over.$"

CinnabarIsland_PokemonLab_ResearchRoom_Text_ReceivedTMFromResearcher::
    .string "{PLAYER} received TM50\n"
    .string "from the researcher.$"

CinnabarIsland_PokemonLab_ResearchRoom_Text_ExplainTM::
    .string "TM50 is EARTHQUAKE.\n"
    .string "That's the clearest signal we've\n"
    .string "pulled from it yet.$"

CinnabarIsland_PokemonLab_ResearchRoom_Text_NoRoomForTM::
    .string "You don't have room for this.\n"
    .string "Come back when you've made some.$"
